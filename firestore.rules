rules_version = '2';
// PopZin — regras do Firestore
// Firebase → Firestore Database → aba "Regras" → cole tudo → troque o e-mail → Publicar
service cloud.firestore {
  match /databases/{database}/documents {

    function ehAdmin() {
      return request.auth != null
        && request.auth.token.email in ['SEU-EMAIL-AQUI@exemplo.com'];
    }

    // data enviada pelo site precisa ser "agora" (evita lixo com datas falsas)
    function criadoAgora() {
      return request.resource.data.criado is timestamp
        && request.resource.data.criado > request.time - duration.value(10, 'm')
        && request.resource.data.criado < request.time + duration.value(10, 'm');
    }

    // catálogo e configurações: qualquer visitante lê, só o administrador altera
    match /produtos/{id} {
      allow read: if true;
      allow write: if ehAdmin();
    }
    match /config/{doc} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    // números da loja: o site só CRIA (visitas e itens no carrinho); só o administrador lê
    match /eventos/{id} {
      allow create: if request.resource.data.keys().hasOnly(['criado', 'tipo', 'json'])
        && request.resource.data.tipo in ['visita', 'carrinho']
        && request.resource.data.json is string && request.resource.data.json.size() < 500
        && criadoAgora();
      allow read, delete: if ehAdmin();
    }

    // pedidos: o site só cria os do WhatsApp; o administrador lê e muda o andamento e o rastreio
    match /pedidos/{id} {
      allow create: if request.resource.data.keys().hasOnly(['criado', 'status', 'json'])
        && request.resource.data.status == 'novo'
        && request.resource.data.json is string && request.resource.data.json.size() < 6000
        && criadoAgora();
      allow read, delete: if ehAdmin();
      // pedidos pagos no site são criados pelo servidor (worker), que não passa por estas regras
      allow update: if ehAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'json'])
        && request.resource.data.status in ['novo', 'aguardando', 'pago', 'preparo', 'enviado', 'entregue', 'expirado', 'cancelado'];
    }

    // qualquer outra coisa: bloqueado
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
